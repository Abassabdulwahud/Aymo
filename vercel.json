{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aymo.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://aymo.onrender.com/auth/:path*"
    },
    {
      "source": "/((?!assets/|sw\\.js|manifest\\.json|favicon\\.ico|.*\\.(?:png|jpg|jpeg|gif|svg|ico|webp)).*)",
      "destination": "/index.html"
    }
  ]
}
